generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Domain {
  id                 String              @id
  normalizedUrl      String              @unique
  isActive           Boolean             @default(false)
  statusCode         Int?
  lastCheckedAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  riskScore          Int?
  isManuallyRisky    Boolean             @default(false)
  manualRiskNote     String?
  manualRiskSetAt    DateTime?
  dataPoints         DomainDataPoint[]
  investigationNotes InvestigationNote[]
  screenshots        Screenshot[]
  urlInputs          UrlInput[]
  scans              WebsiteScan[]

  @@index([normalizedUrl])
  @@index([isManuallyRisky])
  @@index([lastCheckedAt(sort: Desc)])
  @@index([riskScore(sort: Desc)])
}

model InvestigationNote {
  id           String   @id @default(cuid())
  domainId     String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  riskDecision String?
  type         String   @default("note")
  domain       Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([createdAt])
  @@index([type])
}

model UrlInput {
  id        String   @id @default(cuid())
  rawInput  String
  domainId  String
  source    String   @default("search")
  createdAt DateTime @default(now())
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([rawInput])
  @@index([createdAt])
}

model WebsiteScan {
  id             String          @id @default(cuid())
  domainId       String
  url            String
  isActive       Boolean         @default(false)
  statusCode     Int?
  checkedAt      DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  error          String?
  status         String          @default("pending")
  crawlFetchLogs CrawlFetchLog[]
  homepageSkus   HomepageSku[]
  policyLinks    PolicyLink[]
  artifacts      ScanArtifact[]
  dataPoints     ScanDataPoint[]
  screenshots    Screenshot[]
  signalLogs     SignalLog[]
  domain         Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([url])
  @@index([checkedAt])
  @@index([status])
  @@index([domainId, status, createdAt(sort: Desc)])
}

model DomainDataPoint {
  id                String   @id @default(cuid())
  domainId          String
  key               String
  label             String
  value             String
  sources           String
  rawOpenAIResponse String
  extractedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
  domain            Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, key])
  @@index([domainId])
  @@index([key])
}

model ScanDataPoint {
  id                String      @id @default(cuid())
  scanId            String
  key               String
  label             String
  value             String
  sources           String
  rawOpenAIResponse String
  extractedAt       DateTime    @default(now())
  scan              WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([key])
  @@index([scanId, key])
}

model CrawlFetchLog {
  id              String      @id @default(cuid())
  scanId          String
  url             String
  method          String      @default("GET")
  statusCode      Int?
  contentType     String?
  contentLength   Int?
  fetchDurationMs Int?
  errorMessage    String?
  robotsAllowed   Boolean     @default(true)
  source          String
  createdAt       DateTime    @default(now())
  allowedByPolicy Boolean     @default(true)
  blockedReason   String?
  discoveredBy    String?
  latencyMs       Int?
  ok              Boolean     @default(false)
  scan            WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([url])
  @@index([createdAt])
  @@index([scanId, statusCode])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @default("default")
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model SignalLog {
  id           String      @id @default(cuid())
  scanId       String
  category     String
  name         String
  valueType    String
  valueNumber  Float?
  valueString  String?
  valueBoolean Boolean?
  valueJson    String?
  severity     String      @default("info")
  evidenceUrl  String?
  notes        String?
  createdAt    DateTime    @default(now())
  scan         WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([category])
  @@index([name])
  @@index([severity])
  @@index([createdAt])
}

model ScanArtifact {
  id          String      @id @default(cuid())
  scanId      String
  url         String
  type        String
  sha256      String
  snippet     String
  contentType String?
  fetchedAt   DateTime    @default(now())
  scan        WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, type])
  @@index([scanId])
  @@index([sha256])
}

model HomepageSku {
  id                String      @id @default(cuid())
  scanId            String
  sourceUrl         String
  productUrl        String
  productPath       String?
  title             String?
  priceText         String?
  currency          String?
  amount            Float?
  imageUrl          String?
  extractionMethod  String
  confidence        Int
  createdAt         DateTime    @default(now())
  isOnSale          Boolean     @default(false)
  originalAmount    Float?
  originalPriceText String?
  scan              WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, productUrl])
  @@index([scanId])
  @@index([productUrl])
  @@index([confidence])
}

model PolicyLink {
  id                String      @id @default(cuid())
  scanId            String
  policyType        String
  url               String
  discoveredOn      String
  discoveryMethod   String
  verifiedOk        Boolean     @default(false)
  statusCode        Int?
  contentType       String?
  verificationNotes String?
  titleSnippet      String?
  lastCheckedAt     DateTime    @default(now())
  createdAt         DateTime    @default(now())
  scan              WebsiteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, policyType])
  @@index([scanId])
  @@index([url])
}

model HomepageArtifact {
  id            String               @id @default(cuid())
  url           String
  finalUrl      String?
  domain        String
  fetchMethod   String               @default("http")
  statusCode    Int?
  contentType   String?
  ok            Boolean              @default(false)
  redirectChain String?
  latencyMs     Int?
  bytes         Int?
  htmlSha256    String?
  textSha256    String?
  htmlSnippet   String?
  textSnippet   String?
  features      String?
  embedding     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pageType      String               @default("homepage")
  @@index([domain])
  @@index([url])
  @@index([htmlSha256])
  @@index([pageType])
}

model AboutUsAnalysisRun {
  id           String                @id @default(cuid())
  status       String                @default("pending")
  domainIds    String
  domainCount  Int
  pairCount    Int                   @default(0)
  clusterCount Int                   @default(0)
  flaggedCount Int                   @default(0)
  summary      String?
  error        String?
  createdAt    DateTime              @default(now())
  completedAt  DateTime?
  name         String?
  pairs        AboutUsAnalysisPair[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model AboutUsAnalysisPair {
  id                  String             @id @default(cuid())
  runId               String
  domainAId           String
  domainBId           String
  domainAUrl          String
  domainBUrl          String
  textScore           Int
  sharedSentences     String?
  sharedSentenceCount Int                @default(0)
  keywordHitsA        String?
  keywordHitsB        String?
  clusterId           Int?
  flagged             Boolean            @default(false)
  flagReasons         String?
  pageScores          String?
  createdAt           DateTime           @default(now())
  run                 AboutUsAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, domainAId, domainBId])
  @@index([runId])
  @@index([flagged])
  @@index([clusterId])
}

model DomainSimilarityPair {
  id                  String   @id @default(cuid())
  domainAId           String
  domainBId           String
  domainAUrl          String
  domainBUrl          String
  compositeScore      Int      // max across page types (with bonuses)
  sharedSentences     String?  // JSON array of shared sentences
  sharedSentenceCount Int      @default(0)
  pageScores          String?  // JSON array of per-page-type scores
  keywordHitsA        String?  // JSON array
  keywordHitsB        String?  // JSON array
  flagged             Boolean  @default(false)
  flagReasons         String?  // JSON array
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([domainAId, domainBId])
  @@index([domainAId])
  @@index([domainBId])
  @@index([compositeScore(sort: Desc)])
  @@index([flagged])
}

model Screenshot {
  id           String       @id @default(cuid())
  domainId     String
  url          String
  captureType  String       @default("auto")
  format       String       @default("png")
  width        Int
  height       Int
  fileSize     Int
  data         String
  scanId       String?
  error        String?
  durationMs   Int?
  createdAt    DateTime     @default(now())
  pageHeight   Int?
  segment      String       @default("full")
  segmentGroup String?
  segmentIndex Int          @default(0)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scan         WebsiteScan? @relation(fields: [scanId], references: [id])

  @@index([domainId])
  @@index([domainId, createdAt(sort: Desc)])
  @@index([scanId])
  @@index([segmentGroup])
}
